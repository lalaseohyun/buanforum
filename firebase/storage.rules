/* ───────────────────────────────────────
   Firebase Storage 보안 규칙 — Firebase 콘솔 ▸ Storage ▸ 규칙 탭에
   이 내용을 그대로 붙여넣고 게시한다.

   원탁토론 사진(js/storage.js)만 이 버킷을 쓴다.
   경로: forums/{forumId}/board/{teamNo}/{timestamp}.jpg
   ─────────────────────────────────────── */
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /forums/{forumId}/board/{teamNo}/{fileName} {
      // 다운로드 URL 자체가 갤러리에 그대로 박히므로 읽기는 공개로 둔다
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
