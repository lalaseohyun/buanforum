/* ───────────────────────────────────────
   Firestore 보안 규칙 — Firebase 콘솔 ▸ Firestore Database ▸ 규칙 탭에
   이 파일 내용을 그대로 붙여넣고 게시(Publish)한다. (CLI 불필요)

   이 앱의 신뢰 모델(솔직하게 적어둔다) ─
   이건 하룻밤 행사용 내부 도구다. 로그인 시스템이 없고, 전부 익명 인증이다.
   "이 요청이 진행자가 보낸 게 맞는가"는 URL의 ?k= 값(hostKey)이
   config/host 문서의 값과 일치하는지로만 판단한다. "이 팀이 정말 3번
   테이블 사람인가"는 검증하지 않는다(원래 정읍 Node 버전도 그랬다) —
   같은 행사장 안에서만 쓰는 도구이기 때문에 이 정도로 충분하다고 보고
   더 복잡한 사용자 인증(이메일 로그인 등)은 일부러 넣지 않았다.

   고칠 때 ─ 문서 구조를 바꾸면(js/db.js) 이 파일도 같이 고쳐야 한다.
   ─────────────────────────────────────── */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // config/host 문서의 key와, 지금 들어온 쓰기 요청에 실린 hostKey가 같은지 대조한다.
    // config/host 자체는 아래에서 클라이언트에게 절대 읽기를 안 주지만(allow read: if false),
    // 규칙 안의 get()은 그 제한과 무관하게 항상 읽을 수 있다(Firestore 룰의 표준 동작).
    function isHost(forumId) {
      return signedIn()
        && 'hostKey' in request.resource.data
        && request.resource.data.hostKey ==
           get(/databases/$(database)/documents/forums/$(forumId)/config/host).data.key;
    }

    match /forums/{forumId} {
      // 행사 진행 상태(지금 어느 세션인지) — 팀 화면 전체가 구독한다
      allow read: if signedIn();
      allow write: if isHost(forumId);

      match /config/host {
        allow read, write: if false; // 클라이언트는 절대 이 문서에 접근 못 한다(위 get()으로만 대조됨)
      }

      match /quiz/state {
        // isHost()는 request.resource.data(쓰기 페이로드)를 들여다보는데 read 요청엔 그게 없어서
        // read에까지 isHost()를 걸면 항상 permission-denied가 난다. 읽기는 signedIn만 확인.
        allow read: if signedIn();
        allow write: if isHost(forumId);
      }
      match /quiz/live {
        allow read: if signedIn();   // 팀 화면이 구독 — 정답은 공개 시점에만 이 문서에 실린다
        allow write: if isHost(forumId);
      }
      match /quizAnswers/{qid} {
        allow read: if signedIn();   // 순위 계산·새로고침 복구용
        allow write: if signedIn(); // 팀 번호를 검증할 로그인 체계가 없다(위 신뢰 모델 참고)
      }
      match /teams/{teamNo} {
        allow read, write: if signedIn(); // 접속 표시 — 누구나 자기 조를 "접속함"으로 남길 수 있다
      }
      match /slides/{doc} {
        allow read: if signedIn();
        allow write: if isHost(forumId);
      }
      match /board/state {
        allow read: if signedIn();
        allow write: if isHost(forumId);
      }
      // 정책 사진 — 이제 진행자가 자기 컴퓨터에서 올린다(참가자 업로드 없음)
      match /boardPhotos/{photoId} {
        allow read: if signedIn();
        allow write: if isHost(forumId);
      }
      // 공감투표 화면 상태(조별 정책명 포함) — 진행자만 쓴다
      match /policy/live {
        allow read: if signedIn();
        allow write: if isHost(forumId);
      }
      // 공감투표 — 문서 ID가 기기별 voterId다. 자기 문서만 쓰게 막을 로그인 체계가 없으므로
      // (위 신뢰 모델 참고) 익명 인증만 확인한다. 1인 1표 제한은 없다(진행자 요청) —
      // 같은 기기가 다시 내면 이 문서가 새 표로 덮어써질 뿐이다.
      // 초기화는 진행자가 빈 문서로 덮어쓴다.
      match /policyVotes/{voterId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }
  }
}
